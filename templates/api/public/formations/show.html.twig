{% extends 'base.html.twig' %}

{% block title %}Formations{% endblock %}

{% block body %}
    <h1>Formations</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ formation.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ formation.title }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ formation.date }}</td>
            </tr>
            <tr>
                <th>School</th>
                <td>{{ formation.school }}</td>
            </tr>
            <tr>
                <th>Begin</th>
                <td>{{ formation.begin }}</td>
            </tr>
            <tr>
                <th>End</th>
                <td>{{ formation.end }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ formation.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_a_p_i_public_formations_index') }}">back to list</a>

    <a href="{{ path('app_a_p_i_public_formations_edit', {'id': formation.id}) }}">edit</a>

    {{ include('api/public/formations/_delete_form.html.twig') }}
{% endblock %}
